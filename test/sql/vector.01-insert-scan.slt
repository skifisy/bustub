[2,1,1] 1.000000
[3,1,1] 2.000000
[4,1,1] 3.000000

query
SELECT v1, ARRAY [1.0, 1.0, 1.0] <=> v1 as distance FROM t1;
----
[1,1,1] 0.000000
[2,1,1] 0.057191
[3,1,1] 0.129612
[4,1,1] 0.183503

query
SELECT v1, inner_product(ARRAY [1.0, 1.0, 1.0], v1) as distance FROM t1;
----
[1,1,1] -3.000000
[2,1,1] -4.000000
[3,1,1] -5.000000
[4,1,1] -6.000000
